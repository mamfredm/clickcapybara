# Cache rules for Cloudflare Pages. HTML pages are not listed and are always checked for updates.

# Fonts: change only with a new file name
/vendor/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts and styles: every page links them with ?v=<content hash> (build.js), so a change always loads fresh
/js/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/silktide/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video: replaced in place now and then, so keep them for a week
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
